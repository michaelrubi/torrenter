JACKETT_URL=http://localhost:9117
JACKETT_API_KEY=your_jackett_api_key_here

# TMDB API Key (for movie/TV metadata & posters)
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: OMDb API Key (for in-app Rotten Tomatoes % scores and IMDb ratings)
# Free key available at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# PocketBase (accounts, watchlist and the auto-download queue)
PB_URL=https://torrenter.pockethost.io
# The "server" agent account the hourly auto-download scheduler signs in as.
# Leave unset to turn auto-download off.
PB_SERVER_EMAIL=server@torrenter.local
PB_SERVER_PASSWORD=
